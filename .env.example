# Server only. Never expose this through public files or frontend build variables.
OPENAI_API_KEY=
# Exact origins, comma-separated, no trailing slash or wildcard.
SESSION_ALLOWED_ORIGINS=https://your-dispatcher.example
# Separate random operator credential, at least 32 characters. Never use the OpenAI key.
SESSION_ACCESS_TOKEN=
# For local development ONLY: NODE_ENV=development and SESSION_LIMITER_MODE=memory.
# Production requires lib/durable-session-limiter.js to export a durable adapter.
SESSION_LIMITER_MODE=durable
